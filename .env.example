# 本文件只用于示例，所有值均为假值。真实密钥只通过环境变量或 *_FILE 注入。
# 复制为 .env 后自行填写，切勿提交 .env。

# 集群
CLUSTER_ID=local-k3s
WATCH_NAMESPACES=fault-lab

# 诊断服务
DIAGNOSIS_URL=http://localhost:8000
DIAGNOSIS_TOKEN_FILE=/run/secrets/diagnosis-token

# 可观测性
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# DeepSeek（诊断服务使用；不写入任何 Kubernetes 对象）
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Web 控制台静态 Token（仅演示；生产使用 Secret 文件）
CONSOLE_STATIC_TOKENS='viewer-token-replace-me:viewer,approver-token-replace-me:approver'

# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://aegisops:aegisops@localhost:5432/aegisops
