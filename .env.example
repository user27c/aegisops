# AegisOps 环境变量示例（仅变量名与假值，勿提交真实 Secret）

# operator
CLUSTER_ID=local-k3s
WATCH_NAMESPACES=fault-lab
DIAGNOSIS_URL=http://127.0.0.1:8000
DIAGNOSIS_TOKEN_FILE=/run/secrets/diagnosis-token
PROMETHEUS_URL=http://127.0.0.1:19090
LOKI_URL=http://127.0.0.1:13100
OTEL_EXPORTER_OTLP_ENDPOINT=

# alert-gateway
WEBHOOK_BEARER_TOKEN_FILE=/run/secrets/webhook-token
MAX_BODY_BYTES=1048576

# incident-api
AUTH_MODE=static-tokens
STATIC_TOKENS_FILE=/run/secrets/console-auth/tokens
WEB_DIST_DIR=/srv/web
ALLOWED_ORIGINS=http://localhost:5173

# diagnosis
DATABASE_URL=postgresql+asyncpg://aegisops:aegisops@localhost:5433/aegisops
LLM_PROVIDER=fake
DEEPSEEK_API_KEY=replace-me
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# fault-lab
CHAOS_ENABLED=false
PORT=:8080
