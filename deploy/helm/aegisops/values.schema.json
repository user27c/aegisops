{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "clusterID",
        "watchNamespaces"
      ],
      "properties": {
        "clusterID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "imageRegistry": {
          "type": "string",
          "pattern": "^[a-z0-9./-]+$"
        },
        "imageTag": {
          "type": "string",
          "pattern": "^(|[a-zA-Z0-9._-]+)$"
        },
        "watchNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "minItems": 1
        },
        "otelEndpoint": {
          "type": "string",
          "pattern": "^(|https?://.*)$"
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "leaderElection": {
          "type": "boolean"
        },
        "diagnosisTokenSecret": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "diagnosisTokenSecret"
      ]
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "webhookTokenSecret": {
          "type": "string",
          "minLength": 1
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304
        }
      }
    },
    "incidentApi": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auth": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "disabled",
                "static-tokens"
              ]
            },
            "existingSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "properties": {
        "llmProvider": {
          "type": "string",
          "enum": [
            "fake",
            "deepseek"
          ]
        },
        "deepseekExistingSecret": {
          "type": "string"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "internal": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageSize": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi)$"
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "urlSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "boolean"
        },
        "prometheusRule": {
          "type": "boolean"
        },
        "grafanaDashboard": {
          "type": "boolean"
        }
      }
    },
    "alerting": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "smtp": {
          "type": "object",
          "additionalProperties": true
        },
        "email": {
          "type": "object",
          "additionalProperties": true
        },
        "route": {
          "type": "object",
          "additionalProperties": true
        },
        "rules": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "smtp": {
            "type": "object",
            "properties": {
              "smarthost": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "requireTLS": {
                "type": "boolean"
              },
              "auth": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "username": {
                    "type": "string"
                  },
                  "passwordSecret": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "smarthost",
              "from"
            ]
          },
          "email": {
            "type": "object",
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3
                },
                "minItems": 1
              },
              "sendResolved": {
                "type": "boolean"
              },
              "subjectPrefix": {
                "type": "string"
              }
            },
            "required": [
              "to"
            ]
          },
          "route": {
            "type": "object",
            "properties": {
              "groupWait": {
                "type": "string",
                "pattern": "^[0-9]+(s|m|h)$"
              },
              "groupInterval": {
                "type": "string",
                "pattern": "^[0-9]+(s|m|h)$"
              },
              "repeatInterval": {
                "type": "string",
                "pattern": "^[0-9]+(s|m|h)$"
              },
              "criticalRepeatInterval": {
                "type": "string",
                "pattern": "^[0-9]+(s|m|h)$"
              }
            }
          },
          "rules": {
            "type": "object",
            "properties": {
              "warningFor": {
                "type": "string",
                "pattern": "^[0-9]+(s|m|h)$"
              },
              "criticalFor": {
                "type": "string",
                "pattern": "^[0-9]+(s|m|h)$"
              },
              "reconcileErrorRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "diagnosisFailureRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "diagnosisQueueBacklog": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "required": [
          "smtp",
          "email"
        ]
      }
    }
  }
}