# AegisOps 镜像基础版本清单：可读 tag 与固定 digest 成对记录。
# 禁止在 Dockerfile/Helm values/CI 中使用裸 latest。
# 构建脚本从本文件读取并生成固定引用。

GO_BUILDER_TAG=golang:1.25.3-bookworm
GO_BUILDER_DIGEST=

PYTHON_TAG=python:3.12-slim
PYTHON_DIGEST=

NODE_TAG=node:22-bookworm-slim
NODE_DIGEST=

DISTROLESS_TAG=gcr.io/distroless/static-debian12:nonroot
DISTROLESS_DIGEST=

PGVECTOR_TAG=pgvector/pgvector:pg16
PGVECTOR_DIGEST=

# 说明：digest 留空时由 scripts/bootstrap-tools.sh 或手动 `docker inspect --format='{{index .RepoDigests 0}}'` 填充。
# CI 的 make verify 会校验所有引用均已固定 digest。
